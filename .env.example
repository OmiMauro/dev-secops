# Copy this file to .env and change the values.
NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=notes
DB_PASSWORD=change-me
DB_NAME=notes

# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=1h

# Root token of the local Vault dev server (docker compose --profile app).
# Only scripts/vault/setup.sh uses it; the API never sees it.
VAULT_ROOT_TOKEN=change-me-vault-root-token
